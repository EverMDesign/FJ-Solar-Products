---
export const prerender = false;
import '../styles/global.css';

const LOCATION_ID = import.meta.env.LOCATION_ID;
const providedId = Astro.url.searchParams.get('locationId');

if (!LOCATION_ID || providedId !== LOCATION_ID) {
  return new Response('Not found', { status: 404 });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sync Products from GHL</title>
  </head>
  <body class="bg-fj-cream min-h-screen py-10 px-4">
    <img src="/images/FJSP-Logo-Full-Color.png" alt="Faithful Journey Solar" class="h-10 mx-auto mb-6 block" />

    <div class="max-w-[520px] mx-auto bg-white border border-fj-sand rounded p-8">
      <h1 class="font-heading font-extrabold uppercase text-xl text-fj-navy mb-1">Sync GHL Products</h1>
      <p class="text-sm text-fj-navy/60 mb-8">Pull latest products, prices, and shipping from GoHighLevel.</p>

      <div class="space-y-6">
        <div class="bg-fj-cream rounded p-4">
          <p class="text-sm font-semibold text-fj-navy">
            Last Sync: <span id="last-sync" class="text-fj-navy/60">Never</span>
          </p>
          <p class="text-sm font-semibold text-fj-navy">
            Products: <span id="product-count" class="text-fj-navy/60">—</span>
          </p>
        </div>

        <button
          id="sync-btn"
          class="w-full bg-fj-gold hover:bg-transparent border-2 border-fj-gold text-fj-navy hover:text-fj-gold font-heading font-bold uppercase tracking-wide text-sm px-7 py-3.5 rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          🔄 Sync Now
        </button>

        <p id="status" class="text-sm text-center"></p>
      </div>
    </div>

    <script>
      const LOCATION_ID = new URLSearchParams(window.location.search).get('locationId') || '';
      const syncBtn = document.getElementById('sync-btn') as HTMLButtonElement;
      const status = document.getElementById('status')!;
      const lastSync = document.getElementById('last-sync')!;
      const productCount = document.getElementById('product-count')!;

      function updateUI() {
        const stored = localStorage.getItem('lastSyncTime');
        if (stored) {
          const date = new Date(stored);
          lastSync.textContent = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
      }

      syncBtn.addEventListener('click', async () => {
        syncBtn.disabled = true;
        syncBtn.textContent = '⏳ Syncing...';
        status.textContent = '';

        try {
          const res = await fetch('/api/admin/sync-ghl', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ locationId: LOCATION_ID }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || 'Sync failed');
          }

          status.textContent = `✓ Synced ${data.productCount} products`;
          status.className = 'text-sm text-center text-fj-green font-semibold';

          localStorage.setItem('lastSyncTime', new Date().toISOString());
          updateUI();
          productCount.textContent = data.productCount.toString();
        } catch (err) {
          status.textContent = err instanceof Error ? err.message : 'Sync failed';
          status.className = 'text-sm text-center text-red-600 font-semibold';
        } finally {
          syncBtn.disabled = false;
          syncBtn.textContent = '🔄 Sync Now';
        }
      });

      updateUI();
    </script>
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

// Authorize.net's hosted page returns here via an auto-submitting POST (not a plain GET
// redirect) when `hostedPaymentReturnOptions.showReceipt` is false — the POST body carries
// a `response` field with the transaction result as a JSON string. Field names below are
// based on Authorize.net's general docs, not a confirmed real response — same unverified-
// assumption caveat as `authorize-webhook.ts`'s billTo/customer fields (see docs/checkout.md).
// If the shape doesn't match, we just fall back to the generic thank-you message below —
// this page should never fail to render for a customer who already paid.
let transId: string | null = null;
let last4: string | null = null;
let totalAmount: number | null = null;

function parseAuthnetResponse(raw: string): any {
  try {
    return JSON.parse(raw);
  } catch {
    // Try parsing as URL-encoded string (from postMessage)
    const params = new URLSearchParams(raw);
    const response = params.get('response');
    if (response) {
      try {
        return JSON.parse(response);
      } catch {
        return null;
      }
    }
    return null;
  }
}

// Accept Hosted can deliver the response via:
// 1. Postmessage + sessionStorage (when postMessage works): checkout.astro stores it there
// 2. POST request (fallback): response field in form body as JSON string
let responseData: any = null;

// Try sessionStorage first (postMessage path via GET redirect)
// Note: This is server-side, so sessionStorage is not available here.
// Instead, we need to check if the response was passed via POST.
// The postMessage path stores in sessionStorage on the client, but checkout.astro just
// does a GET redirect, so we can't recover the response. The response MUST come via POST fallback.

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const raw = formData.get('response');
    if (typeof raw === 'string') {
      responseData = parseAuthnetResponse(raw);
      if (responseData) {
        transId = responseData.transId ?? responseData.transactionResponse?.transId ?? null;
        const account = responseData.accountNumber ?? responseData.transactionResponse?.accountNumber ?? null;
        if (typeof account === 'string') last4 = account.slice(-4);
        totalAmount = responseData.totalAmount ?? responseData.transactionResponse?.totalAmount ?? null;
      }
    }
  } catch (e) {
    // Unexpected response shape — show the generic message instead of erroring out.
  }
}
---

<Layout title="Thank You — Faithful Journey Solar" noindex={true}>
  <section class="max-w-[640px] mx-auto px-6 py-20 text-center">
    <h1 class="font-heading font-extrabold uppercase text-3xl text-fj-navy mb-4">Thank You For Your Order!</h1>
    <p class="text-fj-navy/70">
      Your payment was successful. We're getting your order ready to ship, and a confirmation
      will be sent to your email shortly.
    </p>

    {
      transId && (
        <p class="text-sm text-fj-navy/50 mt-6">
          Order reference: <span class="font-semibold text-fj-navy">{transId}</span>
          {last4 && <> &middot; Card ending in {last4}</>}
        </p>
      )
    }
    <a
      href="/"
      class="inline-flex items-center justify-center mt-10 bg-fj-gold hover:bg-transparent border-2 border-fj-gold text-fj-navy hover:text-fj-gold font-heading font-bold uppercase tracking-wide text-sm px-7 py-3.5 rounded transition-colors"
    >
      Continue Shopping
    </a>
  </section>

  <script>
    import { clearCart } from '../lib/cart';
    clearCart();
  </script>

  <script define:vars={{ transId, totalAmount }}>
    // On the client side, we have multiple sources for transaction data:
    // 1. Server-side extraction from POST response (if POST fallback worked)
    // 2. Authorize.net response stored in sessionStorage (from postMessage + checkout.astro)
    // 3. Order total stored in sessionStorage by checkout.astro (always available after successful payment form load)

    let finalTransId = transId;
    let finalAmount = totalAmount;

    // Try to recover transaction data from sessionStorage
    if (typeof window !== 'undefined' && window.sessionStorage) {
      try {
        // First priority: Authorize.net response (has transId)
        const authResponse = sessionStorage.getItem('fj-authorize-response');
        if (authResponse) {
          const data = JSON.parse(authResponse);
          finalTransId = data.transId ?? data.transactionResponse?.transId ?? null;
          finalAmount = data.totalAmount ?? data.transactionResponse?.totalAmount ?? null;
          console.log('[thank-you] Recovered transaction from sessionStorage:', { finalTransId, finalAmount });
          sessionStorage.removeItem('fj-authorize-response');
        }

        // Fallback: Order total from checkout.astro (always available, used for pixel if no transId)
        if (!finalAmount) {
          const orderTotalRaw = sessionStorage.getItem('fj-order-total');
          if (orderTotalRaw) {
            const orderTotal = JSON.parse(orderTotalRaw);
            finalAmount = orderTotal.amount;
            console.log('[thank-you] Using order total from checkout:', finalAmount);
          }
        }
      } catch (e) {
        console.error('[thank-you] Error recovering from sessionStorage:', e);
      }
    }

    // Track purchase with Meta Pixel
    // fbq may not be available yet (it loads async), so wait for it
    function firePixelPurchase() {
      if (typeof window !== 'undefined' && window.fbq) {
        console.log('[thank-you] Firing Purchase event:', { value: finalAmount, transId: finalTransId });
        window.fbq('track', 'Purchase', {
          value: finalAmount || 0,
          currency: 'USD',
          content_type: 'product',
        });
      } else {
        console.log('[thank-you] fbq still unavailable, retrying...');
        setTimeout(firePixelPurchase, 100);
      }
    }

    if (typeof window !== 'undefined') {
      firePixelPurchase();
    }
  </script>
</Layout>

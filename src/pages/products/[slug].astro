---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

function formatPrice(amount: number | null, currency: string) {
  if (amount === null) return '';
  return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(amount);
}

const gallery = product.images.length > 0 ? product.images : [product.image].filter(Boolean);
---

<Layout title={`${product.name} — Faithful Journey Solar`} description={product.description.slice(0, 160)}>
  <section class="max-w-[1280px] mx-auto px-6 py-12">
    <a href="/" class="text-sm text-fj-navy/60 hover:text-fj-navy">&larr; Back to shop</a>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-10">
      <div>
        <div class="aspect-square bg-white border border-fj-sand rounded flex items-center justify-center overflow-hidden">
          {gallery[0] ? (
            <img src={gallery[0]} alt={product.name} class="w-full h-full object-contain" />
          ) : (
            <span class="text-fj-navy/30 text-sm">No image</span>
          )}
        </div>
        {gallery.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-2">
            {gallery.slice(1).map((img) => (
              <div class="aspect-square bg-white border border-fj-sand rounded overflow-hidden">
                <img src={img} alt={product.name} class="w-full h-full object-contain" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>

      <div>
        <span class="block text-xs uppercase font-semibold text-fj-green-deep tracking-wide mb-2">{product.brand} Products</span>
        <h1 class="font-heading font-extrabold uppercase text-2xl sm:text-3xl text-fj-navy">{product.name}</h1>
        <p class="mt-2 font-heading font-extrabold text-2xl text-fj-gold">
          <span id="product-price">{product.price !== null ? formatPrice(product.price, product.currency) : 'Contact for price'}</span>
          {product.hasMultiplePrices && !product.variants && (
            <span class="block text-sm font-normal font-sans text-fj-navy/60 mt-1">
              Starting price — options available at checkout
            </span>
          )}
        </p>

        {product.variants && product.variants.length > 0 && (
          <div class="mt-4 max-w-xs space-y-3" id="variants-container">
            <!-- Variants will be rendered here by script -->
          </div>
        )}

        <p id="ship-info" class="mt-3 text-sm text-fj-navy/60"></p>

        <div class="mt-6 flex items-center gap-3">
          {product.price !== null ? (
            <>
              <button
                type="button"
                id="add-to-cart-btn"
                class="inline-flex items-center justify-center bg-fj-gold hover:bg-transparent border-2 border-fj-gold text-fj-navy hover:text-fj-gold font-heading font-bold uppercase tracking-wide text-sm px-7 py-3.5 rounded transition-colors"
                data-slug={product.slug}
                data-name={product.name}
                data-image={product.image}
                data-price={product.price}
                data-currency={product.currency}
              >
                Add to Cart
              </button>
              <a
                href="/cart/"
                id="go-to-cart-link"
                class="hidden inline-flex items-center justify-center border-2 border-fj-navy-deep text-fj-navy hover:bg-fj-navy-deep hover:text-fj-cream font-heading font-bold uppercase tracking-wide text-sm px-7 py-3.5 rounded transition-colors"
              >
                Go to Cart
              </a>
            </>
          ) : (
            <a
              href={`mailto:info@faithfuljourneysolar.com?subject=${encodeURIComponent('Order: ' + product.name)}`}
              class="inline-flex items-center justify-center bg-fj-navy hover:bg-fj-navy-deep text-white font-heading font-bold uppercase tracking-wide text-sm px-7 py-3.5 rounded transition-colors"
            >
              Email Us to Order
            </a>
          )}
        </div>

        <div class="mt-8 prose prose-sm max-w-none whitespace-pre-line text-fj-navy/80">
          {product.description}
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ product }}>
    import { addToCart } from '../../lib/cart';

    const btn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
    const containerEl = document.getElementById('variants-container') as HTMLDivElement | null;
    const priceEl = document.getElementById('product-price');
    const shipInfoEl = document.getElementById('ship-info');

    function formatPrice(amount: number) {
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: btn?.dataset.currency || 'USD' }).format(amount);
    }

    // Parse variant names by " / " delimiter to extract dimensions
    function parseVariantDimensions(variants: any[]): { names: string[]; options: string[][] } | null {
      if (!variants.length) return null;

      const firstName = variants[0].name;
      const parts = firstName.split(' / ');
      if (parts.length <= 1) return null; // No multi-dimensional variants

      const numDimensions = parts.length;
      const dimensionNames = parts;
      const dimensionOptions: string[][] = Array(numDimensions)
        .fill(null)
        .map(() => []);

      variants.forEach((v) => {
        const parts = v.name.split(' / ');
        parts.forEach((part, idx) => {
          if (!dimensionOptions[idx].includes(part)) {
            dimensionOptions[idx].push(part);
          }
        });
      });

      return { names: dimensionNames, options: dimensionOptions };
    }

    function renderVariantSelects() {
      if (!containerEl || !product.variants || product.variants.length === 0) return;

      const parsed = parseVariantDimensions(product.variants);

      if (!parsed) {
        // Single dimension variants - use simple dropdown
        const select = document.createElement('select');
        select.id = 'variant-select';
        select.className =
          'w-full appearance-none bg-white border-2 border-fj-navy-deep rounded px-4 py-2.5 pr-10 text-sm font-semibold text-fj-navy cursor-pointer transition-colors focus:outline-none focus:border-fj-gold';

        const label = document.createElement('label');
        label.htmlFor = 'variant-select';
        label.className = 'block text-sm font-semibold text-fj-navy mb-1';
        label.textContent = product.variantGroupName || 'Options';

        const wrapper = document.createElement('div');
        wrapper.className = 'relative';

        product.variants.forEach((v: any) => {
          const option = document.createElement('option');
          option.value = v.optionId;
          option.dataset.price = v.price;
          option.dataset.weightOz = v.weightOz;
          option.dataset.name = v.name;
          option.dataset.dimensions = v.dimensions ? JSON.stringify(v.dimensions) : '';
          option.textContent = v.name;
          select.appendChild(option);
        });

        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('class', 'pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-fj-gold');
        svg.setAttribute('viewBox', '0 0 20 20');
        svg.setAttribute('fill', 'none');
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', 'M5 7.5L10 12.5L15 7.5');
        path.setAttribute('stroke', 'currentColor');
        path.setAttribute('stroke-width', '2');
        path.setAttribute('stroke-linecap', 'round');
        path.setAttribute('stroke-linejoin', 'round');
        svg.appendChild(path);

        wrapper.appendChild(select);
        wrapper.appendChild(svg);
        containerEl.appendChild(label);
        containerEl.appendChild(wrapper);

        select.addEventListener('change', () => applyVariant(select.options[select.selectedIndex]));
        applyVariant(select.options[select.selectedIndex]);
        return;
      }

      // Multi-dimensional variants - create separate dropdowns
      const selects: HTMLSelectElement[] = [];

      parsed.names.forEach((name, idx) => {
        const label = document.createElement('label');
        label.className = 'block text-sm font-semibold text-fj-navy mb-1';
        label.textContent = name;

        const select = document.createElement('select');
        select.className =
          'w-full appearance-none bg-white border-2 border-fj-navy-deep rounded px-4 py-2.5 pr-10 text-sm font-semibold text-fj-navy cursor-pointer transition-colors focus:outline-none focus:border-fj-gold';
        select.dataset.dimensionIndex = String(idx);

        const defaultOption = document.createElement('option');
        defaultOption.value = '';
        defaultOption.textContent = `Select ${name}`;
        select.appendChild(defaultOption);

        parsed.options[idx].forEach((option) => {
          const opt = document.createElement('option');
          opt.value = option;
          opt.textContent = option;
          select.appendChild(opt);
        });

        const wrapper = document.createElement('div');
        wrapper.className = 'relative';

        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('class', 'pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-fj-gold');
        svg.setAttribute('viewBox', '0 0 20 20');
        svg.setAttribute('fill', 'none');
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', 'M5 7.5L10 12.5L15 7.5');
        path.setAttribute('stroke', 'currentColor');
        path.setAttribute('stroke-width', '2');
        path.setAttribute('stroke-linecap', 'round');
        path.setAttribute('stroke-linejoin', 'round');
        svg.appendChild(path);

        wrapper.appendChild(select);
        wrapper.appendChild(svg);
        containerEl.appendChild(label);
        containerEl.appendChild(wrapper);
        selects.push(select);
      });

      function updateVariantFromSelects() {
        const selections = selects.map((s) => s.value);
        if (selections.some((s) => !s)) {
          // Not all selections made yet
          if (priceEl) priceEl.textContent = formatPrice(product.price);
          if (shipInfoEl) shipInfoEl.textContent = '';
          return;
        }

        const selectedName = selections.join(' / ');
        const matchedVariant = product.variants.find((v: any) => v.name === selectedName);

        if (matchedVariant) {
          applyVariantData(matchedVariant);
        }
      }

      function applyVariantData(variant: any) {
        if (!btn) return;
        const price = Number(variant.price);
        const weightOz = Number(variant.weightOz) || 0;
        const dimensions = variant.dimensions || null;

        btn.dataset.price = String(price);
        btn.dataset.variantOptionId = variant.optionId;
        btn.dataset.variantName = variant.name;
        btn.dataset.weightOz = String(weightOz);
        btn.dataset.dimensions = dimensions ? JSON.stringify(dimensions) : '';

        if (priceEl) priceEl.textContent = formatPrice(price);
        if (shipInfoEl) {
          const lb = (weightOz / 16).toFixed(2);
          shipInfoEl.textContent = dimensions
            ? `Ships in a ${dimensions.length} × ${dimensions.width} × ${dimensions.height} ${dimensions.unit} box, ${lb} lb`
            : weightOz
            ? `Ships at ${lb} lb`
            : '';
        }
      }

      selects.forEach((select) => {
        select.addEventListener('change', updateVariantFromSelects);
      });

      // Set initial display
      if (priceEl) priceEl.textContent = formatPrice(product.price);
    }

    function applyVariant(option: HTMLOptionElement) {
      if (!btn) return;
      const price = Number(option.dataset.price);
      const weightOz = Number(option.dataset.weightOz) || 0;
      const dimensions = option.dataset.dimensions ? JSON.parse(option.dataset.dimensions) : null;

      btn.dataset.price = String(price);
      btn.dataset.variantOptionId = option.value;
      btn.dataset.variantName = option.dataset.name || '';
      btn.dataset.weightOz = String(weightOz);
      btn.dataset.dimensions = option.dataset.dimensions || '';

      if (priceEl) priceEl.textContent = formatPrice(price);
      if (shipInfoEl) {
        const lb = (weightOz / 16).toFixed(2);
        shipInfoEl.textContent = dimensions
          ? `Ships in a ${dimensions.length} × ${dimensions.width} × ${dimensions.height} ${dimensions.unit} box, ${lb} lb`
          : weightOz
          ? `Ships at ${lb} lb`
          : '';
      }
    }

    renderVariantSelects();

    btn?.addEventListener('click', () => {
      const dimensions = btn.dataset.dimensions ? JSON.parse(btn.dataset.dimensions) : null;
      const item = {
        slug: btn.dataset.slug || '',
        name: btn.dataset.name || '',
        image: btn.dataset.image || '',
        price: Number(btn.dataset.price) || 0,
        variantOptionId: btn.dataset.variantOptionId || undefined,
        variantName: btn.dataset.variantName || undefined,
        weightOz: btn.dataset.weightOz ? Number(btn.dataset.weightOz) : undefined,
        dimensions,
      };
      addToCart(item);
      const original = btn.textContent;
      btn.textContent = 'Added!';
      document.getElementById('go-to-cart-link')?.classList.remove('hidden');
      setTimeout(() => (btn.textContent = original), 1200);
    });
  </script>
</Layout>

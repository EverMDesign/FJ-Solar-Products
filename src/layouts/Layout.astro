---
import '../styles/global.css';
import CartDrawer from '../components/CartDrawer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Solar and off-grid power gear from Faithful Journey Solar.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/FJSP-Logo-Icon-Dark.png" />
  </head>
  <body class="min-h-screen flex flex-col">
    <div id="site-banner" class="hidden px-4 py-2.5 text-sm font-semibold text-center"></div>

    <header class="bg-fj-navy text-white sticky top-0 z-[100] border-b-2 border-fj-gold">
      <div class="max-w-[1280px] mx-auto px-6 h-[72px] flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <img src="/images/FJSP-Logo-Full-White.png" alt="Faithful Journey Solar" class="h-9" />
        </a>
        <div class="flex items-center gap-6">
          <a
            href="https://www.facebook.com/fjsolarproducts"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Faithful Journey Solar on Facebook"
            class="text-fj-cream hover:text-fj-gold transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
            </svg>
          </a>
          <button
            type="button"
            id="cart-open-btn"
            class="font-heading font-semibold text-sm uppercase tracking-wide text-fj-cream hover:text-fj-gold transition-colors flex items-center gap-2"
          >
            Cart <span id="cart-count" class="bg-fj-gold text-fj-navy text-xs font-bold px-2 py-0.5 rounded-full">0</span>
          </button>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-fj-navy text-fj-sand border-t-2 border-fj-gold">
      <div class="max-w-[1280px] mx-auto px-6 py-16">
        <div class="mb-12 flex flex-col items-center text-center">
          <img src="/images/FJSP-Logo-Full-White.png" alt="Faithful Journey Solar" class="h-9 mb-4" />
          <p class="text-sm max-w-[300px] mb-4">Professional-grade solar and electrical equipment for RVs, vans, and off-grid builds.</p>
          <a
            href="https://www.facebook.com/fjsolarproducts"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Faithful Journey Solar on Facebook"
            class="inline-flex text-fj-sand hover:text-fj-gold transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
            </svg>
          </a>
        </div>
        <div class="border-t border-fj-navy-deep pt-6 flex justify-center text-xs text-center">
          <span>&copy; {new Date().getFullYear()} Faithful Journey Solar Products. All rights reserved.</span>
        </div>
      </div>
    </footer>

    <CartDrawer />

    <script>
      import { getCartCount } from '../lib/cart';

      const countEl = document.getElementById('cart-count');
      if (countEl) countEl.textContent = String(getCartCount());

      window.addEventListener('cart:updated', (event) => {
        if (countEl) countEl.textContent = String((event as CustomEvent).detail.count);
      });

      document.getElementById('cart-open-btn')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('cart:open'));
      });

      const BANNER_STYLES: Record<string, string> = {
        sale: 'bg-fj-green text-white',
        info: 'bg-banner-blue text-white',
        system: 'bg-banner-amber text-fj-navy',
      };

      fetch('/api/banner')
        .then((res) => res.json())
        .then((data) => {
          if (!data.enabled || !data.message) return;
          const el = document.getElementById('site-banner');
          if (!el) return;
          el.textContent = data.message;
          el.className = `px-4 py-2.5 text-sm font-semibold text-center ${BANNER_STYLES[data.type] || BANNER_STYLES.info}`;
        })
        .catch(() => {
          // Banner just stays hidden if this fails — never blocks the rest of the page.
        });
    </script>
  </body>
</html>
